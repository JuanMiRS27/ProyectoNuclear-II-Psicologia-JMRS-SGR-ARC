# Copiar como .env y ajustar los valores

# Base de datos (PostgreSQL en Docker)
POSTGRES_USER=simulador
POSTGRES_PASSWORD=simulador
POSTGRES_DB=simulador
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Aplicación
ENTORNO=desarrollo
JWT_SECRETO=cambiar-por-un-valor-largo-y-aleatorio
JWT_MINUTOS_EXPIRACION=60

# Correo. En Docker, docker-compose.yml ya apunta a Mailpit (CORREO_MODO=smtp,
# SMTP_HOST=mailpit). Para un proveedor real, definir aquí sus datos.
# CORREO_MODO=smtp
# CORREO_REMITENTE=Simulador de Psicología Social <no-responder@tu-dominio.edu.co>
# SMTP_HOST=smtp.proveedor.com
# SMTP_PUERTO=587
# SMTP_USUARIO=
# SMTP_CLAVE=
# SMTP_TLS=true

# Usuarios de prueba (python -m app.scripts.sembrar_usuarios). Solo para desarrollo.
SEMILLA_ADMIN_CORREO=admin@simulador.edu.co
SEMILLA_ADMIN_CLAVE=Admin.Prueba2026
SEMILLA_DOCENTE_CORREO=docente@simulador.edu.co
SEMILLA_DOCENTE_CLAVE=Docente.Prueba2026
SEMILLA_ESTUDIANTE_CORREO=estudiante@simulador.edu.co
SEMILLA_ESTUDIANTE_CLAVE=Estudiante.Prueba2026
