# Copiar como .env y ajustar los valores

# Base de datos (PostgreSQL en Docker)
POSTGRES_USER=simulador
POSTGRES_PASSWORD=simulador
POSTGRES_DB=simulador
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Aplicación
ENTORNO=desarrollo
JWT_SECRETO=cambiar-por-un-valor-largo-y-aleatorio
JWT_MINUTOS_EXPIRACION=60
