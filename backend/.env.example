# Copie este archivo como .env y reemplace los valores. NUNCA suba .env al repositorio.

# Entorno: development | testing | production
ENVIRONMENT=development

# Conexión a PostgreSQL (driver psycopg 3)
DATABASE_URL=postgresql+psycopg://simulador_user:CAMBIAR_CLAVE@localhost:5432/simulador_psicologia

# Base de datos EXCLUSIVA para pruebas (se crean y destruyen tablas en ella).
# Debe ser una base nueva y vacía; su nombre debe empezar por "test_" o terminar en "_test",
# estar en localhost y ser distinta de DATABASE_URL (ver README, sección Pruebas).
TEST_DATABASE_URL=postgresql+psycopg://simulador_user:CAMBIAR_CLAVE@localhost:5432/simulador_psicologia_test
# Solo para un servidor de pruebas dedicado remoto (p. ej., CI):
# ALLOW_REMOTE_TEST_DATABASE=true

# JWT. Genere una clave con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Mostrar SQL generado por SQLAlchemy (solo desarrollo)
SQL_ECHO=false

# --- Módulo 3: sesiones y convocatorias ---
# Horas tras la hora de fin programada para que el cierre automático finalice una sesión.
SESSION_AUTO_CLOSE_HOURS=24
# Limitación de intentos fallidos de ingreso estudiantil (ventana en segundos).
STUDENT_LOGIN_WINDOW_SECONDS=900
STUDENT_LOGIN_MAX_FAILURES_PER_EMAIL=5
STUDENT_LOGIN_MAX_FAILURES_PER_IP=30
# Permite al docente responsable consultar los códigos de convocatoria (hasta que el módulo 6 los envíe por correo).
CONVOCATION_CODE_RETRIEVAL_ENABLED=true
# Expiración de seguridad del token estudiantil (minutos), independiente del tiempo de participación.
STUDENT_TOKEN_EXPIRE_MINUTES=300
# Clave AES-256 para cifrar los códigos de convocatoria en reposo (32 bytes en Base64 URL-safe). OBLIGATORIA.
# Generar con: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Si se pierde, los códigos existentes no se pueden recuperar (habría que regenerarlos).
CONVOCATION_CODE_ENCRYPTION_KEY=REEMPLAZAR_POR_UNA_CLAVE_GENERADA
